    },
    "payroll": {
      "targetServices": ["apps/api/src/modules/hr/hr-payroll-history.service.ts", "apps/api/src/modules/hr/hr.service.ts"],
      "targetApis": ["GET /hr/payroll/history", "POST /hr/payroll/runs"],
      "targetPages": ["apps/web/app/hr/payroll/HrPayrollClient.tsx"]
    },
    "attendance_leave": {
      "targetServices": ["apps/api/src/modules/hr/hr.service.ts"],
      "targetApis": ["GET /hr/attendance/daily-results", "POST /hr/attendance/daily-results/recalculate"],
