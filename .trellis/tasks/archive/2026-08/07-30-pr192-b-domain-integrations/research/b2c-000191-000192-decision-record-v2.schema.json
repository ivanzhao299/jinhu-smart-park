{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jinhu:property-b:000191-000192:decision-record:v2",
  "title": "000191/000192 change-control decision record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_sha256",
    "trusted_signer_directory_sha256",
    "decisions",
    "decision_makers",
    "approvals",
    "decided_at",
    "acknowledgements"
  ],
  "properties": {
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trusted_signer_directory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DEC-01", "DEC-02", "DEC-03", "DEC-04", "DEC-05", "DEC-06"],
      "properties": {
        "DEC-01": { "$ref": "#/$defs/aOrReplacement" },
        "DEC-02": { "$ref": "#/$defs/abOrReplacement" },
        "DEC-03": { "$ref": "#/$defs/abOrReplacement" },
        "DEC-04": { "$ref": "#/$defs/aOrReplacement" },
        "DEC-05": { "$ref": "#/$defs/aOrReplacement" },
        "DEC-06": { "$ref": "#/$defs/aOrReplacement" }
      }
    },
    "decision_makers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "roles"],
        "properties": {
          "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
          "delegation_statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "product-owner",
                "finance-owner",
                "data-owner",
                "homestay-domain-owner",
                "housing-domain-owner",
                "property-domain-owner",
                "schema-migration-owner",
                "authority-owner",
                "audit-security-owner"
              ]
            }
          }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DEC-01", "DEC-02", "DEC-03", "DEC-04", "DEC-05", "DEC-06"],
      "properties": {
        "DEC-01": { "$ref": "#/$defs/dec01Signatures" },
        "DEC-02": { "$ref": "#/$defs/dec02Signatures" },
        "DEC-03": { "$ref": "#/$defs/dec03Signatures" },
        "DEC-04": { "$ref": "#/$defs/dec04Signatures" },
        "DEC-05": { "$ref": "#/$defs/dec05Signatures" },
        "DEC-06": { "$ref": "#/$defs/dec06Signatures" }
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "legacy_cny_attestation": {
      "type": "string"
    },
    "acknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_authorities_remain_immutable",
        "approval_is_not_migration_reservation",
        "technical_gate_and_uat_are_separate"
      ],
      "properties": {
        "frozen_authorities_remain_immutable": { "const": true },
        "approval_is_not_migration_reservation": { "const": true },
        "technical_gate_and_uat_are_separate": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decisions": {
            "properties": {
              "DEC-03": {
                "properties": { "branch": { "const": "A" } },
                "required": ["branch"]
              }
            },
            "required": ["DEC-03"]
          }
        }
      },
      "then": {
        "required": ["legacy_cny_attestation"],
        "properties": {
          "legacy_cny_attestation": {
            "const": "All legacy housing monetary data in scope may be interpreted and backfilled as CNY."
          }
        }
      }
    }
  ],
  "$defs": {
    "aOrReplacement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch"],
          "properties": { "branch": { "const": "A" } }
        },
        { "$ref": "#/$defs/replacement" }
      ]
    },
    "abOrReplacement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch"],
          "properties": { "branch": { "enum": ["A", "B"] } }
        },
        { "$ref": "#/$defs/replacement" }
      ]
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "replacement_contract"],
      "properties": {
        "branch": { "const": "replacement" },
        "replacement_contract": { "type": "string", "minLength": 20, "maxLength": 10000 }
      }
    },
    "signatureAList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/signatureA" }
    },
    "signatureABList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/signatureAB" }
    },
    "signatureA": {
      "allOf": [
        { "$ref": "#/$defs/signatureBase" },
        {
          "type": "object",
          "properties": { "branch": { "enum": ["A", "replacement"] } }
        }
      ]
    },
    "signatureAB": {
      "allOf": [
        { "$ref": "#/$defs/signatureBase" },
        {
          "type": "object",
          "properties": { "branch": { "enum": ["A", "B", "replacement"] } }
        }
      ]
    },
    "signatureBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_identity", "signer_role", "branch", "decided_at"],
      "properties": {
        "signer_identity": { "type": "string", "minLength": 1, "maxLength": 200 },
        "signer_role": {
          "enum": [
            "product-owner",
            "finance-owner",
            "data-owner",
            "homestay-domain-owner",
            "housing-domain-owner",
            "property-domain-owner",
            "schema-migration-owner",
            "authority-owner",
            "audit-security-owner"
          ]
        },
        "branch": { "type": "string" },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    },
    "dec01Signatures": {
      "allOf": [
        { "$ref": "#/$defs/signatureAList" },
        { "$ref": "#/$defs/requireProduct" },
        { "$ref": "#/$defs/requireHomestay" },
        { "$ref": "#/$defs/requireFinance" }
      ]
    },
    "dec02Signatures": {
      "allOf": [
        { "$ref": "#/$defs/signatureABList" },
        { "$ref": "#/$defs/requireProduct" },
        { "$ref": "#/$defs/requireFinance" },
        { "$ref": "#/$defs/requireData" }
      ]
    },
    "dec03Signatures": {
      "allOf": [
        { "$ref": "#/$defs/signatureABList" },
        { "$ref": "#/$defs/requireProduct" },
        { "$ref": "#/$defs/requireFinance" },
        { "$ref": "#/$defs/requireData" }
      ]
    },
    "dec04Signatures": {
      "allOf": [
        { "$ref": "#/$defs/signatureAList" },
        { "$ref": "#/$defs/requireProduct" },
        { "$ref": "#/$defs/requireHousing" },
        { "$ref": "#/$defs/requireFinance" }
      ]
    },
    "dec05Signatures": {
      "allOf": [
        { "$ref": "#/$defs/signatureAList" },
        { "$ref": "#/$defs/requireProduct" },
        { "$ref": "#/$defs/requireHousing" },
        { "$ref": "#/$defs/requireFinance" },
        {
          "contains": {
            "properties": {
              "signer_role": { "enum": ["data-owner", "audit-security-owner"] }
            },
            "required": ["signer_role"]
          },
          "minContains": 1
        }
      ]
    },
    "dec06Signatures": {
      "allOf": [
        { "$ref": "#/$defs/signatureAList" },
        { "$ref": "#/$defs/requireProduct" },
        { "$ref": "#/$defs/requireHousing" },
        { "$ref": "#/$defs/requireFinance" },
        { "$ref": "#/$defs/requireAudit" }
      ]
    },
    "requireProduct": {
      "contains": {
        "properties": { "signer_role": { "const": "product-owner" } },
        "required": ["signer_role"]
      },
      "minContains": 1
    },
    "requireFinance": {
      "contains": {
        "properties": { "signer_role": { "const": "finance-owner" } },
        "required": ["signer_role"]
      },
      "minContains": 1
    },
    "requireData": {
      "contains": {
        "properties": { "signer_role": { "const": "data-owner" } },
        "required": ["signer_role"]
      },
      "minContains": 1
    },
    "requireHomestay": {
      "contains": {
        "properties": { "signer_role": { "const": "homestay-domain-owner" } },
        "required": ["signer_role"]
      },
      "minContains": 1
    },
    "requireHousing": {
      "contains": {
        "properties": { "signer_role": { "const": "housing-domain-owner" } },
        "required": ["signer_role"]
      },
      "minContains": 1
    },
    "requireAudit": {
      "contains": {
        "properties": { "signer_role": { "const": "audit-security-owner" } },
        "required": ["signer_role"]
      },
      "minContains": 1
    }
  }
}
