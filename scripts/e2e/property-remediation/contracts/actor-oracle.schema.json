{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "property-remediation-a-base-actor-oracle-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "actors"],
  "properties": {
    "schema_version": { "const": "property-remediation-a-base-actor-oracle-v1" },
    "actors": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "identity", "bundle_codes", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "kind": { "enum": ["ordinary", "support", "exception_super"] },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["is_super", "raw_permissions"],
            "properties": {
              "is_super": { "type": "boolean" },
              "raw_permissions": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "bundle_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^property-bundle:[a-z-]+$" }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modules", "permissions", "menu_routes", "data_scopes"],
            "properties": {
              "modules": {
                "type": "array", "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "permissions": {
                "type": "array", "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "menu_routes": {
                "type": "array", "uniqueItems": true,
                "items": { "type": "string", "pattern": "^/" }
              },
              "data_scopes": {
                "type": "array", "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
