    {"id": "t5-skill", "sourceTable": "knowhow", "sourceColumnPattern": ".*", "targetLocators": ["hr_employee_skill"], "evidence": "scripts/transform-yuzhou-t5-legacy-history.mjs"},
    {"id": "t5-credential", "sourceTable": "ticket", "sourceColumnPattern": ".*", "targetLocators": ["hr_employee_credential"], "evidence": "scripts/transform-yuzhou-t5-legacy-history.mjs"},
    {"id": "t3-attendance-calendar", "sourceTable": "timekeeptable", "sourceColumnPattern": ".*", "targetLocators": ["hr_attendance_calendar_source", "hr_attendance_day"], "evidence": "scripts/transform-yuzhou-t3-attendance-insurance.mjs"},
    {"id": "t3-insurance-policy", "sourceTable": "insure_method", "sourceColumnPattern": ".*", "targetLocators": ["hr_insurance_policy", "hr_insurance_policy_item"], "evidence": "scripts/transform-yuzhou-t3-attendance-insurance.mjs"},
    {"id": "t3-insurance-month", "sourceTable": "person_insure", "sourceColumnPattern": "^(?:id|recyear|recmonth|person|base|base_(?:oldage|remedy|losework|fund|wound|bear)|(?:oldage|remedy|losework|fund|wound|bear)(?:_e|_p|_pc)?)$", "targetLocators": ["hr_employee_insurance_period", "hr_employee_insurance_item"], "evidence": "scripts/transform-yuzhou-t3-attendance-insurance.mjs"},
    {"id": "t4-payroll-items", "sourceTable": "salaryitems", "sourceColumnPattern": "^(?:scheme|itemname|description|itemtype|datatype|addorsub|declen|myorder)$", "targetLocators": ["hr_payroll_item_definition", "hr_payroll_item_version"], "evidence": "scripts/sql/load-yuzhou-t4-payroll-history.sql"},
    {"id": "t4-payroll-formula", "sourceTable": "salaryequal", "sourceColumnPattern": ".*", "targetLocators": ["hr_payroll_formula_version"], "evidence": "scripts/sql/load-yuzhou-t4-payroll-history.sql"},
    {"id": "t4-payroll-close", "sourceTable": "salarycount", "sourceColumnPattern": ".*", "targetLocators": ["hr_payroll_book_period"], "evidence": "scripts/sql/load-yuzhou-t4-payroll-history.sql"},
    {"id": "t4-payroll-membership", "sourceTable": "schemes", "sourceColumnPattern": ".*", "targetLocators": ["hr_payroll_book_membership"], "evidence": "scripts/sql/load-yuzhou-t4-payroll-history.sql"},
    {"id": "t4-payroll-tax", "sourceTable": "tax", "sourceColumnPattern": ".*", "targetLocators": ["hr_payroll_tax_rule_version"], "evidence": "scripts/sql/load-yuzhou-t4-payroll-history.sql"},
    {"id": "t4-payroll-period-employee", "sourceTablePattern": "^salary(?:0[1-9]|[12][0-9]|3[0-5])$", "sourceColumnPattern": "^(?:year|month|person)$", "targetLocators": ["hr_payroll_book_period", "hr_payroll_legacy_snapshot"], "evidence": "scripts/transform-yuzhou-t4-payroll-history.mjs"},
    {"id": "t4-payroll-dynamic-item", "sourceTablePattern": "^salary(?:0[1-9]|[12][0-9]|3[0-5])$", "sourceColumnPattern": "^(?:S|U|Q).+", "targetLocators": ["hr_payroll_legacy_snapshot_item"], "evidence": "scripts/transform-yuzhou-t4-payroll-history.mjs"}
  ],
