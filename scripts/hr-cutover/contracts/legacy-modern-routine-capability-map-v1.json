      "targetApis": ["GET /hr/decision-center/workforce", "GET /hr/employment-events/statistics"],
      "targetPages": ["apps/web/app/hr/decision-center/HrDecisionCenterClient.tsx"]
    },
    "collaboration_records": {
      "targetServices": ["apps/api/src/modules/hr/hr-legacy-archive.service.ts"],
      "targetApis": ["GET /hr/legacy-archive/:id"],
      "targetPages": ["apps/web/app/hr/employees/legacy/LegacyArchivePageClient.tsx"]
    },
    "authorization_audit": {
      "targetServices": ["apps/api/src/modules/roles/roles.service.ts"],
      "targetApis": [],
      "targetPages": []
    },
    "custom_configuration": {"targetServices": [], "targetApis": [], "targetPages": []},
    "technical_residue": {"targetServices": [], "targetApis": [], "targetPages": []}
  },
  "productionImport": "HOLD"
}
