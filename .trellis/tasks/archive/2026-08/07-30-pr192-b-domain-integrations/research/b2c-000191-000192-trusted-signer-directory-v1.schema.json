{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jinhu:property-b:000191-000192:trusted-signer-directory:v1",
  "title": "000191/000192 trusted signer directory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_id", "issued_at", "issued_by", "entries"],
  "properties": {
    "authority_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string", "minLength": 1, "maxLength": 200 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "roles", "evidence_reference"],
        "properties": {
          "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "product-owner",
                "finance-owner",
                "data-owner",
                "homestay-domain-owner",
                "housing-domain-owner",
                "property-domain-owner",
                "schema-migration-owner",
                "authority-owner",
                "audit-security-owner"
              ]
            }
          },
          "delegation_statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence_reference": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
