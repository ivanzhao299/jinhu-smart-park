  "implementedNormalizationRules": [
    {"id": "t0-org-code", "sourceTable": "departmentcode", "sourceColumnPattern": "^(?:department|departmentname|rating|master|defpersons|tel|myorder|id)$", "targetLocators": ["sys_org"], "evidence": "scripts/extract-yuzhou-t0.sh"},
    {"id": "t0-position", "sourceTable": "job", "sourceColumnPattern": "^(?:job|jobname|department|parentjob|upto|jobgrade|salarygrade|authority|qualify|respos|defpersons|manual|rating|myorder|id)$", "targetLocators": ["hr_position"], "evidence": "scripts/extract-yuzhou-t0.sh"},
    {"id": "t0-employee", "sourceTable": "person", "sourceColumnPattern": "^(?:person|name|department|job|jobstate|persontype|injobdate|formaldate|awaydate)$", "targetLocators": ["hr_employee"], "evidence": "scripts/extract-yuzhou-t0.sh"},
    {"id": "t5-employee-profile", "sourceTable": "person", "sourceColumnPattern": "^(?:idcard|sex|birthday|race|political|marital|addr|tel|handtel|email|edu|secedu|speciality|graduatescholl|graduatedate)$", "targetLocators": ["hr_employee_profile"], "evidence": "scripts/transform-yuzhou-t5-legacy-history.mjs"},
