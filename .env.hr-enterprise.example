# Separate deployment only. Never point this at the integrated database or file root.
NODE_ENV=production
APP_ENV=production
APP_RUNTIME_MODE=hr_enterprise
APP_PORT=3001
API_PREFIX=api/v1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jinhu_hr_enterprise
POSTGRES_USER=jinhu
POSTGRES_PASSWORD=replace_with_private_database_password
FILE_STORAGE_LOCAL_ROOT=/var/lib/jinhu-hr-enterprise/files
JWT_SECRET=replace_with_distinct_long_random_secret
PARTY_DATA_ENCRYPTION_KEY=replace_with_distinct_private_key_at_least_32_characters
AUTH_SMS_FIXED_CODE=
AUTH_SMS_CODE_VISIBLE=false
AUTH_WECHAT_MOCK_ENABLED=false
AUTH_REFRESH_COOKIE_NAME=hr_enterprise_refresh
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_TOKEN_BODY_COMPAT=false
AUTH_COOKIE_ORIGIN_CHECK_ENABLED=true
AUTH_ALLOWED_ORIGINS=https://replace-with-independent-hr-origin.example
# Set the same server-side mode when building/running Web. This is presentation, not authorization.
NEXT_PUBLIC_API_TARGET=http://127.0.0.1:3001
