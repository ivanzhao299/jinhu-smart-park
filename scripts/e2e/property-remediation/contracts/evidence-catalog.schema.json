{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "property-remediation-a-base-evidence-catalog-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "test_ids", "evidence_ids"],
  "properties": {
    "schema_version": { "const": "property-remediation-a-base-evidence-catalog-v1" },
    "test_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^A0-[A-Z]+-[0-9]+$" }
    },
    "evidence_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^a0-[a-z-]+$" }
    }
  }
}
