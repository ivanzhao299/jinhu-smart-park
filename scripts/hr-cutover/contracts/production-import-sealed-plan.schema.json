{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://park.cnjinhu.com/schemas/hr-yuzhou-production-import-sealed-plan-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "planKind", "operationId", "intent", "status", "triple", "target", "targetScope", "window", "authorization", "manifestSha256", "finalRehearsalPair", "phaseOrder", "phases", "rollback", "sealing", "productionImport"],
  "properties": {
    "formatVersion": { "const": 2 },
    "planKind": { "const": "yuzhou_hr_production_import_sealed_execution_plan" },
    "operationId": { "type": "string", "pattern": "^yzprod-import-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$" },
    "intent": { "const": "production_import" },
    "status": { "const": "SEALED" },
    "triple": {
      "type": "object", "additionalProperties": false,
      "required": ["codeSha", "sourceSnapshotHash", "mappingContractHash"],
      "properties": { "codeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sourceSnapshotHash": { "$ref": "#/$defs/sha256" }, "mappingContractHash": { "$ref": "#/$defs/sha256" } }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["environment", "alias", "identitySha256"],
      "properties": { "environment": { "const": "production" }, "alias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,63}$" }, "identitySha256": { "$ref": "#/$defs/sha256" } }
    },
    "targetScope": { "$ref": "#/$defs/targetScope" },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["startsAt", "endsAt"],
      "properties": { "startsAt": { "type": "string", "format": "date-time" }, "endsAt": { "type": "string", "format": "date-time" } }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["intent", "artifactSha256", "nonceSha256", "issuedAt", "expiresAt", "binding", "approvalSet"],
      "properties": {
        "intent": { "const": "production_import" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }, "nonceSha256": { "$ref": "#/$defs/sha256" }, "issuedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" },
        "binding": {
          "type": "object", "additionalProperties": false,
          "required": ["triple", "targetIdentitySha256", "targetScopeSha256", "finalRehearsalPairSha256", "manifestSha256", "windowStartsAt", "windowEndsAt"],
          "properties": {
            "triple": { "$ref": "#/$defs/triple" }, "targetIdentitySha256": { "$ref": "#/$defs/sha256" }, "targetScopeSha256": { "$ref": "#/$defs/sha256" }, "finalRehearsalPairSha256": { "$ref": "#/$defs/sha256" }, "manifestSha256": { "$ref": "#/$defs/sha256" },
            "windowStartsAt": { "type": "string", "format": "date-time" }, "windowEndsAt": { "type": "string", "format": "date-time" },
            "performanceRelationsContractSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "approvalSet": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "subjectRefSha256", "signedDecisionSha256"],
            "properties": { "role": { "enum": ["hr_owner", "data_security_owner", "release_owner"] }, "subjectRefSha256": { "$ref": "#/$defs/sha256" }, "signedDecisionSha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      }
    },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "finalRehearsalPair": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactSha256", "triple", "rehearsals"],
      "properties": {
        "artifactSha256": { "$ref": "#/$defs/sha256" }, "triple": { "$ref": "#/$defs/triple" },
        "rehearsals": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/rehearsalA" },
            { "$ref": "#/$defs/rehearsalB" }
          ],
          "items": false
        }
      }
    },
    "phaseOrder": { "const": ["T0", "T1", "T2", "T3"] },
    "phases": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/phase" } },
    "performanceRelations": { "$ref": "#/$defs/performanceRelations" },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "insert", "merge", "quarantine", "skipApproved", "residualCount", "canonicalHash"],
      "properties": { "order": { "const": ["T3", "T2", "T1", "T0"] }, "insert": { "const": "delete_operation_owned_target" }, "merge": { "const": "encrypted_before_image_cas_restore" }, "quarantine": { "const": "no_target_write" }, "skipApproved": { "const": "no_target_write" }, "residualCount": { "const": 0 }, "canonicalHash": { "const": "EXACT" } }
    },
    "sealing": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "sealedPlanSha256"],
      "properties": { "algorithm": { "const": "canonical-json-sha256-v1" }, "sealedPlanSha256": { "$ref": "#/$defs/sha256" } }
    },
    "productionImport": { "const": "HOLD" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "triple": {
      "type": "object", "additionalProperties": false,
      "required": ["codeSha", "sourceSnapshotHash", "mappingContractHash"],
      "properties": { "codeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sourceSnapshotHash": { "$ref": "#/$defs/sha256" }, "mappingContractHash": { "$ref": "#/$defs/sha256" } }
    },
    "scopeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
    "targetScope": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "parkId", "scopeSha256"],
      "properties": { "tenantId": { "$ref": "#/$defs/scopeId" }, "parkId": { "$ref": "#/$defs/scopeId" }, "scopeSha256": { "$ref": "#/$defs/sha256" } }
    },
    "performanceRelations": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "bindingKind", "triple", "sourceConservationContractSha256", "sourceFactLocationReceiptSha256", "sourceFactLocationCanonicalSha256", "relationPayloadArtifactSha256", "identityDecisionArtifactSha256", "t0PhaseReceiptSha256", "migration305Sha256", "migration306Sha256", "sessionRows", "scoreSourceRows", "assignmentRows", "activeRelationMaps", "identityResolutionRows", "subjectUnmatchedRows", "blankAssessorRows", "forwardOrder", "rollbackOrder", "adapterStatus", "executionReachable", "productionImport"],
      "properties": {
        "formatVersion": { "const": 1 },
        "bindingKind": { "const": "yuzhou_hr_production_import_performance_relations_held_binding" },
        "triple": { "$ref": "#/$defs/triple" },
        "sourceConservationContractSha256": { "$ref": "#/$defs/sha256" },
        "sourceFactLocationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "sourceFactLocationCanonicalSha256": { "$ref": "#/$defs/sha256" },
        "relationPayloadArtifactSha256": { "$ref": "#/$defs/sha256" },
        "identityDecisionArtifactSha256": { "$ref": "#/$defs/sha256" },
        "t0PhaseReceiptSha256": { "$ref": "#/$defs/sha256" },
        "migration305Sha256": { "$ref": "#/$defs/sha256" },
        "migration306Sha256": { "$ref": "#/$defs/sha256" },
        "sessionRows": { "const": 7 },
        "scoreSourceRows": { "const": 0 },
        "assignmentRows": { "const": 117 },
        "activeRelationMaps": { "const": 124 },
        "identityResolutionRows": { "const": 234 },
        "subjectUnmatchedRows": { "const": 108 },
        "blankAssessorRows": { "const": 117 },
        "forwardOrder": { "const": ["source_person_assignments", "identity_resolution"] },
        "rollbackOrder": { "const": ["identity_resolution", "source_person_assignments"] },
        "adapterStatus": { "const": "UNAVAILABLE" },
        "executionReachable": { "const": false },
        "productionImport": { "const": "HOLD" }
      }
    },
    "rehearsalBase": {
      "type": "object", "additionalProperties": false,
      "required": ["rehearsal", "manifestSha256", "cleanupAuditSha256", "residualCount"],
      "properties": { "rehearsal": { "type": "string" }, "manifestSha256": { "$ref": "#/$defs/sha256" }, "cleanupAuditSha256": { "$ref": "#/$defs/sha256" }, "residualCount": { "const": 0 } }
    },
    "rehearsalA": { "allOf": [{ "$ref": "#/$defs/rehearsalBase" }, { "properties": { "rehearsal": { "const": "A" } } }] },
    "rehearsalB": { "allOf": [{ "$ref": "#/$defs/rehearsalBase" }, { "properties": { "rehearsal": { "const": "B" } } }] },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "ordinal", "sourceBatchManifestSha256", "payloadBundleArtifactSha256", "payloadBundleSha256", "canonicalizationVersion", "beforeCanonicalSha256", "expectedAfterCanonicalSha256", "records"],
      "properties": {
        "phase": { "enum": ["T0", "T1", "T2", "T3"] }, "ordinal": { "type": "integer", "minimum": 0, "maximum": 3 },
        "sourceBatchManifestSha256": { "$ref": "#/$defs/sha256" }, "payloadBundleArtifactSha256": { "$ref": "#/$defs/sha256" }, "payloadBundleSha256": { "$ref": "#/$defs/sha256" }, "canonicalizationVersion": { "const": "yuzhou-production-import-canonical-json-v1" }, "beforeCanonicalSha256": { "$ref": "#/$defs/sha256" }, "expectedAfterCanonicalSha256": { "$ref": "#/$defs/sha256" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSystem", "sourceTable", "sourcePkCanonical", "sourceIdentitySha256", "sourceRowSha256", "payloadSha256", "plannedTargetTable", "dependencyMode", "dependencyRefs", "disposition"],
      "properties": {
        "sourceSystem": { "const": "yuzhou-v10" }, "sourceTable": { "type": "string", "pattern": "^dbo\\.[A-Za-z0-9_]{1,128}$" }, "sourcePkCanonical": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceIdentitySha256": { "$ref": "#/$defs/sha256" }, "sourceRowSha256": { "$ref": "#/$defs/sha256" }, "payloadSha256": { "$ref": "#/$defs/sha256" }, "plannedTargetTable": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" },
        "dependencyMode": { "enum": ["scope", "employee", "record_graph"] },
        "dependencyRefs": { "type": "array", "items": { "$ref": "#/$defs/dependencyRef" } },
        "disposition": { "enum": ["insert", "merge", "quarantine", "skip_approved"] }, "targetTable": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }, "targetId": { "type": "string", "format": "uuid" },
        "businessIdentitySha256": { "$ref": "#/$defs/sha256" }, "expectedTargetBeforeSha256": { "$ref": "#/$defs/sha256" }, "expectedTargetAfterSha256": { "$ref": "#/$defs/sha256" }, "expectedTargetVersionBefore": { "type": "integer", "minimum": 0 }, "targetVersionAfter": { "type": "integer", "minimum": 0 }, "decisionAttestationSha256": { "$ref": "#/$defs/sha256" },
        "beforeImage": {
          "type": "object", "additionalProperties": false,
          "required": ["algorithm", "plaintextSha256", "ciphertextSha256", "keyReferenceSha256"],
          "properties": { "algorithm": { "const": "aes-256-gcm-external-kek-v1" }, "plaintextSha256": { "$ref": "#/$defs/sha256" }, "ciphertextSha256": { "$ref": "#/$defs/sha256" }, "keyReferenceSha256": { "$ref": "#/$defs/sha256" } }
        },
        "quarantine": {
          "type": "object", "additionalProperties": false,
          "required": ["reasonCode", "algorithm", "payloadCiphertextSha256", "keyReferenceSha256"],
          "properties": { "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }, "algorithm": { "const": "aes-256-gcm-external-kek-v1" }, "payloadCiphertextSha256": { "$ref": "#/$defs/sha256" }, "keyReferenceSha256": { "$ref": "#/$defs/sha256" } }
        }
      }
    },
    "dependencyRef": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "phase", "sourceIdentitySha256", "expectedTargetTable"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
        "phase": { "enum": ["T0", "T1", "T2", "T3"] },
        "sourceIdentitySha256": { "$ref": "#/$defs/sha256" },
        "expectedTargetTable": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }
      }
    }
  }
}
