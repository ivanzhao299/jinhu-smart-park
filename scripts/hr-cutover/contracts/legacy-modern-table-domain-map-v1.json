  "decompositionRules": [
    {"id": "department-code-hierarchy", "sourceTable": "departmentcode", "sourceColumnPattern": "^department$", "targetLocators": ["sys_org.org_code", "sys_org.parent_id"], "method": "code_length_3_6_9_12_to_explicit_parent"},
    {"id": "person-wide-domain-split", "sourceTable": "person", "sourceColumnPattern": ".*", "targetLocators": ["hr_employee", "hr_employee_profile", "hr_employee_compensation", "hr_employee_insurance_period", "hr_employee_document"], "method": "semantic_field_group_split"},
    {"id": "person-custom-fields", "sourceTable": "person", "sourceColumnPattern": "^def(?:[1-9]|1[1-5]|2[1-5])$", "targetLocators": ["hr_custom_field_definition", "hr_employee_custom_value"], "method": "wide_custom_columns_to_typed_rows"},
    {"id": "attendance-days", "sourceTable": "timekeeptable", "sourceColumnPattern": "^date(?:[1-9]|[12][0-9]|3[01])$", "targetLocators": ["hr_attendance_day.attendance_date", "hr_attendance_day.legacy_symbol"], "method": "month_day_column_to_daily_row"},
    {"id": "insurance-kinds", "sourceTable": "person_insure", "sourceColumnPattern": "^(?:base|oldage|remedy|losework|wound|bear|fund)(?:_[a-z]+)?$", "targetLocators": ["hr_employee_insurance_period", "hr_employee_insurance_item"], "method": "six_kind_wide_amounts_to_period_item_rows"},
    {"id": "salary-dynamic-items", "sourceTablePattern": "^salary(?:0[1-9]|[12][0-9]|3[0-5])$", "sourceColumnPattern": "^(?:S|U|Q).+", "targetLocators": ["hr_payroll_legacy_snapshot_item.legacy_column_name", "hr_payroll_legacy_snapshot_item.decimal_value", "hr_payroll_legacy_snapshot_item.text_value", "hr_payroll_legacy_snapshot_item.date_value"], "method": "dynamic_salary_column_to_typed_item_row"},
    {"id": "binary-object-extraction", "sourceTypePattern": "^(?:image|binary|varbinary)", "targetLocators": ["hr_legacy_file_blob_object", "hr_legacy_file_logical_record", "sys_file"], "method": "content_hash_deduplicated_object_storage"}
  ],
  "currentExtractionTables": [
