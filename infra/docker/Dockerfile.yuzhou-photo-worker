# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim

ARG APT_MIRROR=

RUN set -eux; \
  printf '%s\n' \
    'Acquire::Retries "5";' \
    'Acquire::http::Timeout "30";' \
    'Acquire::https::Timeout "30";' \
    > /etc/apt/apt.conf.d/80-retries-timeouts; \
  apt_install() { \
    for attempt in 1 2 3; do \
      apt-get update \
        && apt-get install -y --no-install-recommends --fix-missing "$@" \
        && return 0; \
      if [ "$attempt" = "3" ]; then return 1; fi; \
      rm -rf /var/lib/apt/lists/*; \
      sleep $((attempt * 5)); \
    done; \
  }; \
  if [ -n "$APT_MIRROR" ]; then \
    mirror="${APT_MIRROR%/}"; \
    sed -i -E \
      -e "s|https?://deb.debian.org/debian-security|${mirror}/debian-security|g" \
      -e "s|https?://security.debian.org/debian-security|${mirror}/debian-security|g" \
      -e "s|https?://deb.debian.org/debian|${mirror}/debian|g" \
      /etc/apt/sources.list.d/debian.sources; \
  fi; \
  apt_install ca-certificates ffmpeg; \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY scripts/hr-cutover/yuzhou-photo-normalization-preflight.mjs ./yuzhou-photo-normalization-preflight.mjs
COPY scripts/hr-cutover/yuzhou-photo-normalization-worker.mjs ./yuzhou-photo-normalization-worker.mjs
RUN mkdir /input /output && chown node:node /input /output

USER node
ENTRYPOINT ["node", "yuzhou-photo-normalization-worker.mjs"]
