{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jinhu://hr-cutover/legacy-atomic-inventory-v1",
  "title": "Yuzhou HR legacy structural atomic inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "inventoryKind", "generatorVersion", "sourceArtifacts", "summary", "tables", "routines", "pages", "permissions"],
  "properties": {
    "formatVersion": { "const": 1 },
    "inventoryKind": { "const": "yuzhou_hr_legacy_structural_atomic_inventory" },
    "generatorVersion": { "const": "1.0.0" },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/sourceArtifact" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables", "columns", "procedures", "functions", "triggers", "rules", "pages"],
      "properties": {
        "tables": { "const": 162 },
        "columns": { "const": 2364 },
        "procedures": { "const": 194 },
        "functions": { "const": 16 },
        "triggers": { "const": 2 },
        "rules": { "const": 212 },
        "pages": { "const": 46 }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 162,
      "maxItems": 162,
      "items": { "$ref": "#/$defs/table" }
    },
    "routines": {
      "type": "array",
      "minItems": 212,
      "maxItems": 212,
      "items": { "$ref": "#/$defs/routine" }
    },
    "pages": {
      "type": "array",
      "minItems": 46,
      "maxItems": 46,
      "items": { "$ref": "#/$defs/page" }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expectedAuthorizationGrantEdges", "reasonCode", "importerContract"],
      "properties": {
        "status": { "const": "pending_review" },
        "expectedAuthorizationGrantEdges": { "const": 915 },
        "reasonCode": { "const": "PERMISSION_GRANT_EDGE_INVENTORY_REQUIRES_PRIVATE_REVIEW" },
        "importerContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "policy"],
          "properties": {
            "input": { "const": "explicit_private_authorization_grant_export" },
            "output": { "const": "private_migration_review_only" },
            "policy": { "const": "no_user_bound_rows_in_public_inventory_no_functionality_credit" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stableId": { "type": "string", "pattern": "^(TABLE|COLUMN|RULE|PAGE)-[A-F0-9]{16}$" },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fileName", "sha256"],
      "properties": {
        "kind": { "enum": ["table_catalog", "help_topics", "routine_source"] },
        "fileName": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "nullable", "default", "description", "structuralHash"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "nullable": { "enum": [true, false] },
        "default": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "structuralHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceArtifactSha256", "columnCount", "columns", "structuralHash"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "columnCount": { "type": "integer", "minimum": 1 },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
        "structuralHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "sourceArtifactSha256", "structuralHash"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["procedure", "function", "trigger"] },
        "name": { "type": "string", "minLength": 1 },
        "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "structuralHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceKey", "title", "sourceArtifactSha256", "structuralHash"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "sourceKey": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "structuralHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
