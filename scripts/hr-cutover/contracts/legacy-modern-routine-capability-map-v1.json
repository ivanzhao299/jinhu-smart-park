      "targetApis": ["GET /hr/performance-v2/reviews", "POST /hr/performance-v2/score-preview"],
      "targetPages": ["apps/web/app/hr/performance/HrPerformanceClient.tsx"]
    },
    "training": {
      "targetServices": ["apps/api/src/modules/hr/hr-training.service.ts"],
      "targetApis": ["GET /hr/training/plans", "POST /hr/training/plans"],
      "targetPages": ["apps/web/app/hr/training/HrTrainingClient.tsx"]
    },
    "reward_discipline": {
      "targetServices": ["apps/api/src/modules/hr/hr-rewards.service.ts"],
      "targetApis": ["GET /hr/rewards/cases", "POST /hr/rewards/cases"],
